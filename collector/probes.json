  {
   "id": "cetsp_cameras",
   "url": "https://www.cetsp.com.br/consultas/cameras-cet.aspx",
   "grep": [
    "Cams/\\d+/\\d+\\.jpg",
    "[^\"'<>]{0,80}Cams/\\d+[^\"'<>]{0,80}",
    "<option[^>]*>[^<]{0,80}",
    "[^\"'<> ]*\\.(aspx|ashx|json)[^\"'<> ]*"
   ],
   "grepMax": 80,
   "head": 1500
  },
  {
   "id": "dersp_map",
   "url": "https://dersp.der.sp.gov.br/WebSite/Servicos/ServicosOnline/CamerasOnlineMapa.aspx",
   "grep": [
    "[^\"'<> ]*\\.(m3u8|json|ashx|asmx|js)[^\"'<> ]*",
    "-?\\d{1,2}\\.\\d{4,}\\s*,\\s*-?\\d{1,3}\\.\\d{4,}",
    "[Ll]at[^,;]{0,40}",
    "nip\\.io[^\"'<> ]*"
   ],
   "grepMax": 60,
   "head": 1500
  },
  {
   "id": "quebec_geojson",
