   "json": true,
   "head": 2500,
   "timeout": 60000
  },
  {
   "id": "overpass_kumi_count",
   "url": "https://overpass.kumi.systems/api/interpreter?data=%5Bout%3Ajson%5D%5Btimeout%3A170%5D%3B(nwr%5B%22contact%3Awebcam%22%5D%3Bnwr%5B%22webcam%22%5D%3B)%3Bout%20count%3B",
   "json": true,
   "full": true,
   "timeout": 180000
  },
  {
