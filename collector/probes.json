   },
   "body": {
    "draw": 1,
    "columns": [
     {
      "data": "sortId",
      "name": "sortId",
      "searchable": true,
      "orderable": true,
      "search": {
       "value": "",
       "regex": false
      }
     },
     {
      "data": "roadway",
      "name": "roadway",
      "searchable": true,
      "orderable": true,
      "search": {
       "value": "",
       "regex": false
      }
     }
    ],
    "order": [
     {
      "column": 0,
      "dir": "asc"
     }
    ],
    "start": 0,
    "length": 10,
    "search": {
     "value": "",
     "regex": false
    }
   },
   "save": 3000
  },
  {
   "id": "tn_cams",
   "url": "https://www.tdot.tn.gov/opendata/api/public/RoadwayCameras",
   "noOrigin": true,
   "save": 2000
  },
  {
   "id": "wy_cams",
   "url": "https://www.wyoroad.info/highway/webcameras/webcameras.html",
   "noOrigin": true,
   "text": true,
   "save": 60000
  },
  {
   "id": "ar_cams",
   "url": "https://layers.idrivearkansas.com/cameras.geojson",
   "noOrigin": true,
   "save": 3000
  },
  {
   "id": "ma_cars",
   "url": "https://mass511.com/api/graphql",
   "noOrigin": true,
   "method": "POST",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": [
    {
     "query": "query MapFeatures($input: MapFeaturesArgs!) { mapFeaturesQuery(input: $input) { mapFeatures { tooltip uri __typename } error { message } } }",
     "variables": {
      "input": {
       "north": 42.9,
       "south": 41.2,
       "east": -69.8,
       "west": -73.6,
       "zoom": 12,
       "layerSlugs": [
        "normalCameras",
        "hotspotCameras",
        "trafficCameras",
        "cameras"
       ],
       "nonClusterableUris": []
      }
     }
    }
   ],
   "save": 3000
  }
 ]
}