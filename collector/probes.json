{
 "probes": [
  {
   "id": "cars_co",
   "url": "https://511.cotrip.org/api/graphql",
   "noOrigin": true,
   "timeout": 90000,
   "method": "POST",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": [
    {
     "query": "query MapFeatures($input: MapFeaturesArgs!) { mapFeaturesQuery(input: $input) { mapFeatures { tooltip uri features { geometry } __typename ... on Camera { views(limit: 30) { uri ... on CameraView { title category url sources { type src } } category } } } error { message } } }",
     "variables": {
      "input": {
       "north": 39.8,
       "south": 39.6,
       "east": -104.8,
       "west": -105.1,
       "zoom": 12,
       "layerSlugs": [
        "normalCameras"
       ],
       "nonClusterableUris": []
      }
     }
    }
   ],
   "save": 20000
  },
