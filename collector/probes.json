   "grep": [
    "href=\"/[a-z]{2}/[^\"]+\"",
    "href=\"[^\"]*camera[^\"]*\""
   ],
   "grepMax": 60,
   "head": 400
  },
  {
   "id": "vejoaovivo_www",
   "url": "https://www.vejoaovivo.com.br/",
   "grep": [
    "href=\"[^\"]+\"",
    "[^\"'<> ]*(api|json|m3u8|camera|/cam)[^\"'<> ]*"
   ],
   "grepMax": 60,
   "head": 400
  },
  {
   "id": "santoandre_cam",
